<Window x:Class="ISCALE.MVVM.View.OperatorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISCALE.MVVM.View"
        xmlns:userControl="clr-namespace:ISCALE.MVVM.View.ControlViews" xmlns:viewmodel="clr-namespace:ISCALE.MVVM.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:OperatorVM}"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Title="OperatorView" Height="750" Width="950" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Style="{StaticResource PrimaryWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <userControl:ControlWindowHeaderView Grid.ColumnSpan="2"/>
        <userControl:ControlProfileHeaderView Grid.ColumnSpan="2" Grid.Row="1"/>
        <!-- ID and Date -->
        <Grid Grid.Row="2" Margin="10 5" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Job ID:" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBlock HorizontalAlignment="Right" Grid.Column="1" Grid.ColumnSpan="3" TextTrimming="CharacterEllipsis" TextAlignment="Right" Text="{Binding CurrentTransaction.JobId, UpdateSourceTrigger=PropertyChanged}" Margin="5 0" VerticalAlignment="Center"/>

            <TextBlock Text="Transaction #:" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock HorizontalAlignment="Right" Grid.Column="1" TextTrimming="CharacterEllipsis" TextAlignment="Right" Grid.Row="1" Text="{Binding CurrentTransaction.TransactionId, UpdateSourceTrigger=PropertyChanged}" Margin="5 0" VerticalAlignment="Center"/>
            <TextBlock Text="Date Time:" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="2" Margin="5 0" VerticalAlignment="Center"/>
            <TextBlock HorizontalAlignment="Right" Grid.Row="1" Grid.Column="3" TextAlignment="Right" Text="{Binding CurrentTransaction.CreatedAt, UpdateSourceTrigger=PropertyChanged}" Margin="5 0" TextTrimming="CharacterEllipsis"/>

            <TextBlock Text="Weigher Name:" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBlock HorizontalAlignment="Right" Grid.Column="1" TextTrimming="CharacterEllipsis" TextAlignment="Right" Grid.Row="2" Text="{Binding CurrentTransaction.Weigher}" Margin="5 0" VerticalAlignment="Center"/>
            <TextBlock Text="Weighing Scale #:" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="2" Margin="5 0 0 0"/>
            <TextBlock HorizontalAlignment="Right" Grid.Column="3" TextTrimming="CharacterEllipsis" TextAlignment="Right" Grid.Row="2" Text="{Binding CurrentTransaction.ScaleNo}" Margin="5 0" VerticalAlignment="Center"/>

            <Rectangle Grid.Row="3" Margin="0 7 0 0" Grid.ColumnSpan="4"  Stroke="{StaticResource MediumGrayBrush}" Height="1" StrokeThickness="1" StrokeDashArray="2 2" SnapsToDevicePixels="True"/>
        </Grid>
        <!-- Fill up Form -->
        <Grid Grid.Row="4" Height="230" Visibility="{Binding FormVisibility}" Grid.ColumnSpan="2" Margin="10 0 10 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Text="Operator #:" VerticalAlignment="Center" Margin="0"/>
            <TextBox Text="{Binding CurrentTransaction.OperatorNo, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" x:Name="TBX_OPERATORNO" Margin="0 0 5 0" VerticalAlignment="Center" TextAlignment="Center" Grid.Column="1" IsEnabled="{Binding IsFormEnabled}" />

            <TextBlock Text="Packer #:" VerticalAlignment="Center" Grid.Row="1"/>
            <TextBox Text="{Binding CurrentTransaction.PackerNo, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" Grid.Row="1" Grid.Column="1" TextAlignment="Center" Margin="0 0 5 0"  IsEnabled="{Binding IsFormEnabled}"/>

            <TextBlock Text="Machine #: " VerticalAlignment="Center" Grid.Row="2" />
            <TextBox Text="{Binding CurrentTransaction.MachineNo, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" VerticalAlignment="Center" TextAlignment="Center" Grid.Row="2" Grid.Column="1" Margin="0 0 5 0"  IsEnabled="{Binding IsFormEnabled}"/>

            <TextBlock Text="QA #: " VerticalAlignment="Center" Grid.Row="3" />
            <TextBox Text="{Binding CurrentTransaction.QaNo, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" VerticalAlignment="Center" TextAlignment="Center" Grid.Row="3" Grid.Column="1" Margin="0 0 5 0"  IsEnabled="{Binding IsFormEnabled}"/>

            <TextBlock Text="Item Code #:" VerticalAlignment="Center" Grid.Column="2" Margin="5 0 0 0"/>
            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Grid.Column="3" MaxLength="30" TextAlignment="Center"  IsEnabled="{Binding IsFormEnabled}"/>

            <TextBlock Text="Item Display Name: " VerticalAlignment="Center" Grid.Column="2" Grid.Row="1" Margin="5 0 0 0"/>
            <TextBlock FontSize="15" Style="{StaticResource DisabledTextBlock}" TextTrimming="CharacterEllipsis" Text="{Binding CurrentTransaction.Item.Description, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"  Grid.Row="1" Grid.Column="3" TextAlignment="Center"/>

            <TextBlock Text="Section: " VerticalAlignment="Center" Grid.Column="2" Grid.Row="2" Margin="5 0 0 0"/>
            <ComboBox Grid.Row="2" Grid.Column="3" HorizontalContentAlignment="Center"  IsEnabled="{Binding IsFormEnabled}"
                      Background="#F4F5F7" Style="{StaticResource ComboBoxStyle1}" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"/>

            <Button Grid.Row="3" Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource BlackButton_patched}" Content="Start" Width="130" Command="{Binding StartScaleCommand}"/>
        </Grid>
        <!-- Form & Scale -->
        <!-- {Binding ScaleVisibility} -->
        <Grid Grid.Row="5" Margin="10 0" Grid.ColumnSpan="2" Height="270" Visibility="{Binding ScaleVisibility}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid Margin="0 0 5 0" Height="auto">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Section:" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CurrentTransaction.Section}" VerticalAlignment="Center" Grid.Column="1" HorizontalAlignment="Right" />

                <TextBlock Text="Item Code #:" VerticalAlignment="Center" Grid.Row="1"/>
                <TextBlock Text="{Binding CurrentTransaction.Item.Code}" VerticalAlignment="Center" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" />

                <TextBlock Text="Item Display Name:" VerticalAlignment="Top" Margin="0 5" Grid.Row="2" />
                <TextBlock MaxHeight="70" Text="{Binding CurrentTransaction.Item.Description}" Margin="0 5" MinHeight="20" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"  Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" />

                <TextBlock Text="Upper Limit:" VerticalAlignment="Center" Grid.Row="3" />
                <TextBlock Text="{Binding CurrentTransaction.Item.UpperLimit, Converter={StaticResource KiloFormatter}}" VerticalAlignment="Center" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" />

                <TextBlock Text="Lower Limit:" VerticalAlignment="Center" Grid.Row="4" />
                <TextBlock Text="{Binding CurrentTransaction.Item.LowerLimit, Converter={StaticResource KiloFormatter}}" VerticalAlignment="Center" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right" />

                <TextBlock Text="Machine #:" VerticalAlignment="Center" Grid.Row="5" />
                <TextBlock Text="{Binding CurrentTransaction.MachineNo}" VerticalAlignment="Center" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Right" />

                <TextBlock Text="QA #:" VerticalAlignment="Center" Grid.Row="6" />
                <TextBlock Text="{Binding CurrentTransaction.QaNo}" VerticalAlignment="Center" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Right" />

                <TextBlock Text="Operator #:" VerticalAlignment="Center" Grid.Row="7"/>
                <TextBlock Text="{Binding CurrentTransaction.OperatorNo}" VerticalAlignment="Center" Grid.Row="7" Grid.Column="1" HorizontalAlignment="Right" />

                <TextBlock Text="Packer #:" VerticalAlignment="Center" Grid.Row="8" />
                <TextBlock Text="{Binding CurrentTransaction.PackerNo}" VerticalAlignment="Center" Grid.Row="8" Grid.Column="1" HorizontalAlignment="Right" />

            </Grid>

            <Grid Grid.Column="2" Grid.ColumnSpan="2" Margin="5 0 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="130"/>
                </Grid.RowDefinitions>
                <TextBlock FontSize="17" Margin="0 10 0 0" Text="Scale Weight" TextAlignment="Center"/>
                <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="43" FontWeight="SemiBold" Text="{Binding SerialData, StringFormat='{}{0} KG'}" Style="{Binding ScaleStyle}" MaxHeight="50" TextAlignment="Center"/>
                <!--- DEMO BUTTON -->
                <Button Content="Demo Capture" Style="{StaticResource BlackButton}" MaxWidth="150" Grid.Row="3" Visibility="{Binding DemoButtonVisibility}" Command="{Binding DemoCaptureCommand}"/>
                <TextBlock Grid.Row="2" Text="{Binding ScaleTimer}" FontWeight="SemiBold" FontSize="25" TextAlignment="Center" Margin="0 10"/>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid Margin="5" Background="#00BD26" Visibility="{Binding SuccessIconVisibility}">
                        <Image Source="/Images/Icons/success.png" Width="100" Height="100" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <Grid Margin="5" Background="#CC0000" Grid.Column="1" Visibility="{Binding FailedIconVisibility}">
                        <Image Source="/Images/Icons/failed.png" Width="100" Height="100" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <!-- Table & Buttons -->
        <Grid Grid.Row="6" Grid.ColumnSpan="2" Visibility="{Binding TableVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <DataGrid Name="DG_TRANSACTION_ITEM" Margin="10" ItemsSource="{Binding CurrentTransaction.TransactionItems}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Width=".1*" Binding="{Binding Id}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="5"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Weight" Width=".26*" Binding="{Binding Weight, Converter={StaticResource KiloFormatter}}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="5"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Status" Width=".26*" Binding="{Binding Status}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="5"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Foreground" Value="{Binding StatusForeground}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Timestamp" Width=".26*" Binding="{Binding DateCreatedString}"/>
                    <DataGridTemplateColumn Header="Delete" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Margin="5" IsChecked="{Binding IsDeleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        CommandParameter="{Binding}"
                                          Command="{Binding DataContext.DeleteCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="1" Margin="10 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="Total Weight (Success):"/>
                <TextBlock Text="Average Weight (Success):" Grid.Row="1"/>
                <TextBlock Text="Shift:" Grid.Row="2"/>
                <TextBlock Text="Count Delete:" Grid.Row="3"/>

                <TextBlock Text="{Binding CurrentTransaction.TotalSuccessWeight, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource KiloFormatter}}" Margin="0 0 5 0" TextAlignment="Right" Grid.Column="1"/>
                <TextBlock Text="{Binding CurrentTransaction.AverageWeight, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource KiloFormatter}}" Margin="0 0 5 0" TextAlignment="Right" Grid.Row="1" Grid.Column="1"/>
                <TextBlock Text="{Binding CurrentTransaction.ScheduleShift, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 5 0" TextAlignment="Right" Grid.Row="2" Grid.Column="1"/>
                <TextBlock Text="{Binding CurrentTransaction.DeletedCount, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 5 0" TextAlignment="Right" Grid.Row="3" Grid.Column="1"/>

                <TextBlock Text="Count Success:" Margin="5 0 0 0" Grid.Column="2"/>
                <TextBlock Text="Count Failed:" Margin="5 0 0 0" Grid.Row="1" Grid.Column="2"/>
                <TextBlock Text="Total Weight (Failed):" Margin="5 0 0 0" Grid.Row="2" Grid.Column="2"/>
                <TextBlock Text="Total Overall Count:" Margin="5 0 0 0" Grid.Row="3" Grid.Column="2"/>

                <TextBlock Text="{Binding CurrentTransaction.SuccessCount, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Grid.Column="3"/>
                <TextBlock Text="{Binding CurrentTransaction.FailedCount}" TextAlignment="Right" Grid.Row="1" Grid.Column="3"/>
                <TextBlock Text="{Binding CurrentTransaction.TotalFailedWeight, Converter={StaticResource KiloFormatter}}" TextAlignment="Right" Grid.Row="2" Grid.Column="3"/>
                <TextBlock Text="{Binding CurrentTransaction.TotalCount}" TextAlignment="Right" Grid.Row="3" Grid.Column="3"/>
            </Grid>
            <Button Grid.Column="2" Grid.Row="2" HorizontalAlignment="Right" Margin="0 10 10 10" Style="{StaticResource BlackButton_patched}" Content="Finish" Width="130" Command="{Binding FinishCommand}"/>
        </Grid>
    </Grid>
</Window>
