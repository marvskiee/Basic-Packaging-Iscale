<Window x:Class="ISCALE.MVVM.View.ModalViews.ModalUploadBulkItemView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISCALE.MVVM.View.ModalViews" xmlns:modalvms="clr-namespace:ISCALE.MVVM.ViewModel.ModalVMS" d:DataContext="{d:DesignInstance Type=modalvms:ModalUploadBulkItemVM}"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Title="ModalUploadBulkItemView" Height="500" Width="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock VerticalAlignment="Center" Margin="10" Text="Upload Bulk Item Form" FontWeight="SemiBold" FontSize="18"/>

        <TextBlock Text="{Binding Message}" FontSize="14" Grid.Row="1" TextAlignment="Center" Style="{Binding MessageStyle}" Grid.ColumnSpan="2"/>
        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{Binding FilePath, StringFormat='Folder Path: {0}'}" Margin="10" TextTrimming="CharacterEllipsis"/>
        <Button Grid.Column="1" HorizontalAlignment="Right" Width="131.1" Grid.Row="2" Command="{Binding ChooseFileCommand}" Content="Choose File" IsEnabled="{Binding IsFormEnabled}" Style="{StaticResource WhiteButton_patched}" Margin="5 10 10 10"/>

        <Grid Grid.ColumnSpan="2" Grid.Row="3" Margin="10 0 10 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.ColumnSpan="3" VerticalAlignment="Center" Margin ="0 0 0 2"  Text="Batch Details" FontWeight="SemiBold" FontSize="18"/>
            <StackPanel Grid.Row="1" Margin="0 0 5 0">
                <TextBlock Text="Effectivity Date" Margin="0 0 0 5"/>
                <DatePicker Style="{StaticResource D2_patched}" SelectedDate="{Binding CurrentProductMetadata.EffectiveDate, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="5 0">
                <TextBlock Text="Doc. Ref. No.:" Margin="0 0 0 5"/>
                <TextBox MaxLength="30" x:Name="TBX_DOC" Text="{Binding CurrentProductMetadata.DocumentReferenceNo, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="5 0 0 0">
                <TextBlock Text="Rev. No.:" Margin="0 0 0 5"/>
                <TextBox MaxLength="30" Text="{Binding CurrentProductMetadata.RevisionNo, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>


        <TextBlock VerticalAlignment="Center" Grid.Row="4" Margin="10" Text="Item List " FontWeight="SemiBold" FontSize="18"/>
        <DataGrid Grid.ColumnSpan="2" Grid.Row="5" Margin="10 0 10 10" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ItemsSource="{Binding Items}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width=".2*"/>
                <DataGridTextColumn Header="Internal Reference" Binding="{Binding InternalReference}" Width=".3*" />
                <DataGridTextColumn Header="Display Name" Binding="{Binding Description}" Width=".3*" />
                <DataGridTextColumn Header="Lower Limit" Binding="{Binding LowerLimit}" Width=".2*" />
                <DataGridTextColumn Header="Upper Limit" Binding="{Binding UpperLimit}" Width=".2*" />
            </DataGrid.Columns>
        </DataGrid>
        <Button HorizontalAlignment="Left" Width="131.1" Grid.Row="6" Command="{Binding CloseCommand}" Content="Close" Style="{StaticResource WhiteButton_patched}" Margin="10 0 10 10"/>
        <Button Grid.Column="1" HorizontalAlignment="Right" Width="131.1" Grid.Row="6" Command="{Binding SubmitCommand}" Content="Submit" Style="{StaticResource BlackButton_patched}" Margin="5 0 10 10"/>
    </Grid>
</Window>
