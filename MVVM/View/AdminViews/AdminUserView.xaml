<UserControl x:Class="ISCALE.MVVM.View.AdminViews.AdminUserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ISCALE.MVVM.View.AdminViews" xmlns:adminvms="clr-namespace:ISCALE.MVVM.ViewModel.AdminVMS" d:DataContext="{d:DesignInstance Type=adminvms:AdminUserVM}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <!-- Grid Layout-->
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <!-- Form Layout-->
        <Grid Background="White" Margin="10 10 10 5">
            <StackPanel Margin="10" Orientation="Vertical">
                <TextBlock Text="User Form" FontWeight="SemiBold" FontSize="20" Margin="0 0 0 2"/>
                <!-- First Row-->
                <Grid Margin="0 0 0 5">
                    <!--First Row Layout-->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <!-- First Row Content-->
                    <StackPanel Orientation="Vertical" Margin="0 0 5 0">
                        <TextBlock Text="Username" Margin="0 0 0 5"/>
                        <TextBox Text="{Binding TempTableItem.Username, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="5 0 5 0">
                        <TextBlock Text="Password" Margin="0 0 0 5"/>
                        <TextBox Text="{Binding TempTableItem.Password, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Vertical" Margin="5 0  0 0">
                        <TextBlock Text="Role"  Margin="0 0 0 5"/>
                        <ComboBox x:Name="CBX_ROLE"
                          ItemsSource="{Binding Roles}"
                          Background="#F4F5F7"     
                          SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                  Style="{DynamicResource ComboBoxStyle1}"
                                  />
                    </StackPanel>
                </Grid>
                <!-- Second Row-->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="5 5 0 0 ">
                    <Button Width="131.5" Content="{Binding AddLabel}" Style="{StaticResource BlackButton_patched}" Margin="0 0 5 0" Command="{Binding SaveCommand}"/>
                    <Button Width="131.5" Grid.Column="1" Content="{Binding ClearLabel}" Style="{StaticResource WhiteButton_patched}" Margin="5 0 0 0" Command="{Binding ClearCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <!-- Table Content-->
        <Grid Grid.Row="1" Background="White" Margin="10 5 10 10">
            <!--Table Layout-->
            <Grid.RowDefinitions >
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Margin="10" Text="User List" FontWeight="SemiBold" FontSize="18"/>
            <DataGrid Margin="10 0 10 10" Grid.Row="1" 
                ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedTableItem}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width=".6*"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width=".2*"/>
                    <DataGridTemplateColumn Header="Delete" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete" Style="{StaticResource RedButton_patched}" Command="{Binding DataContext.DeleteCommand,Mode=OneWay,RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                    CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
