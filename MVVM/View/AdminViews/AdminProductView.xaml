<UserControl x:Class="ISCALE.MVVM.View.AdminViews.AdminProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ISCALE.MVVM.View.AdminViews"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid>
            <!-- Grid Layout-->
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <!-- Form Layout-->
            <Grid Background="White" Margin="10 10 10 5">
                <StackPanel Margin="10" Orientation="Vertical">
                    <TextBlock Text="Batch Details" FontWeight="SemiBold" FontSize="20" Margin="0 0 0 2"/>
                    <!-- First Row-->
                    <StackPanel>
                        <!-- First Row Content-->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Effectivity Date:" Margin="0 5 0 5"/>
                            <TextBlock Text="{Binding CurrentProductMetadata.EffectiveDate}" Grid.Column="1" Margin="0 5 5 5" HorizontalAlignment="Right"/>

                            <TextBlock Text="Document Reference No.:" Margin="5" Grid.Column="2"/>
                            <TextBlock Text="{Binding CurrentProductMetadata.DocumentReferenceNo}" Grid.Column="3" HorizontalAlignment="Right" Margin="5 5 0 5"/>
                            
                            <TextBlock Text="Revision No.:" Margin="0 5 0 5" Grid.Row="1"/>
                            <TextBlock Text="{Binding CurrentProductMetadata.RevisionNo}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" Margin="0 5 5 5"/>
                            
                            <TextBlock Text="Last Upload:" Margin="5" Grid.Row="1" Grid.Column="2"/>
                            <TextBlock Text="{Binding CurrentProductMetadata.CreatedAtString}" Grid.Column="3" Grid.Row="1" HorizontalAlignment="Right" Margin="5 5 0 5"/>
                        </Grid>

                    </StackPanel>

                    <!-- Second Row-->
                    <StackPanel HorizontalAlignment="Right"  Orientation="Horizontal" Margin="5 7 0 0 ">
                        <Button HorizontalAlignment="Left" Width="131.5" Content="Upload" Style="{StaticResource BlackButton_patched}" Margin="0 5 5 0" Command="{Binding UploadCommand}"/>
                        <Button HorizontalAlignment="Left" Width="131.5" Content="Export" Style="{StaticResource WhiteButton_patched}" Margin="5 5 0 0" Command="{Binding ExportCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <!-- Table Content-->
            <Grid Grid.Row="1" Background="White" Margin="10 5 10 10">
                <!--Table Layout-->
                <Grid.RowDefinitions >
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock VerticalAlignment="Center" Margin="10" Text="Item List" FontWeight="SemiBold" FontSize="18"/>
                <DataGrid 
                Margin="10 0 10 10" 
                Grid.Row="1" ItemsSource="{Binding CurrentProductMetadata.ProductItem}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code #" Binding="{Binding Code}" Width=".2*"/>
                        <DataGridTextColumn Header="Internal Reference" Binding="{Binding InternalReference}" Width=".3*" />
                        <DataGridTextColumn Header="Display Name" Binding="{Binding Description}" Width=".3*" />
                        <DataGridTextColumn Header="Upper Limit" Binding="{Binding UpperLimit, Converter={StaticResource KiloFormatter}}" Width=".2*"/>
                        <DataGridTextColumn Header="Lower Limit" Binding="{Binding LowerLimit, Converter={StaticResource KiloFormatter}}" Width=".2*"/>
                        <DataGridTemplateColumn Header="Delete" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Delete" Style="{StaticResource RedButton_patched}" Command="{Binding DataContext.DeleteCommand,Mode=OneWay,RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                    CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
