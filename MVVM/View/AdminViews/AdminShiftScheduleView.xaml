<UserControl x:Class="ISCALE.MVVM.View.AdminViews.AdminShiftScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ISCALE.MVVM.View.AdminViews"
             mc:Ignorable="d" 
             xmlns:local1="clr-namespace:ISCALE.MVVM.View.ControlViews"
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <Grid Margin="10 10 10 5" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Today Shift Schedule" FontWeight="SemiBold" FontSize="18" Margin="10 10 10 2"/>
        
            <TextBlock Text="Day Shift Range" TextAlignment="Center" FontSize="17" Margin="10 10 10 5" Grid.Row="1"/>
            <TextBlock Text="Night Shift Range" TextAlignment="Center" FontSize="17" Margin="10 10 10 5" Grid.Row="1" Grid.Column="1"/>

            <TextBlock FontWeight="Medium" Text="{Binding OriginalDayShiftStartPreview, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" FontSize="21" Margin="10" Grid.Row="2"/>
            <TextBlock Text="To" TextAlignment="Center" FontSize="17" Margin="5" Grid.Row="3"/>
            <TextBlock FontWeight="Medium" Text="{Binding OriginalDayShiftEndPreview, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" FontSize="21" Margin="10" Grid.Row="4"/>

            <TextBlock FontWeight="Medium" Text="{Binding OriginalNightShiftStartPreview, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" FontSize="21" Margin="10" Grid.Row="2" Grid.Column="1"/>
            <TextBlock Text="To" TextAlignment="Center" FontSize="17" Margin="5" Grid.Row="3" Grid.Column="1"/>
            <TextBlock FontWeight="Medium" Text="{Binding OriginalNightShiftEndPreview, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" FontSize="21" Margin="10 10 10 15" Grid.Row="4" Grid.Column="1"/>
        </Grid>

        <Grid Margin="10 5 10 10" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Shift Form" FontWeight="SemiBold" FontSize="18" Margin="10 10 10 2"/>

            <StackPanel Grid.Row="1" Margin="10 0 5 5">
                <TextBlock Text="Day Shift Start" Margin="0 0 0 5"/>
                <local1:ControlTimePickerView  
                    Margin="0 0 0 10"
                    SelectedTime="{Binding DayShiftStart, Mode=TwoWay}"/>
                <TextBlock Text="Day Shift End" Margin="0 0 0 5"/>
                <local1:ControlTimePickerView 
                    Margin="0 0 0 5"
                    SelectedTime="{Binding DayShiftEnd, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Preview" TextAlignment="Center" FontSize="16" FontWeight="Medium"/>
                <TextBlock Text="{Binding DayShiftStartPreview,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" FontSize="17" Margin="5" Grid.Row="2"/>
                <TextBlock Text="To" TextAlignment="Center" FontSize="16" Margin="8" Grid.Row="3"/>
                <TextBlock Text="{Binding DayShiftEndPreview,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" FontSize="17" Margin="5" Grid.Row="4"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="5 0 10 5" Grid.Row="1">
                <TextBlock Text="Night Shift Start" Margin="0 0 0 5"/>
                <local1:ControlTimePickerView 
                    Margin="0 0 0 10" 
                    SelectedTime="{Binding NightShiftStart, Mode=TwoWay}"/>
                <TextBlock Text="Night Shift End" Margin="0 0 0 5"/>
                <local1:ControlTimePickerView 
                    Margin="0 0 0 0"
                    SelectedTime="{Binding NightShiftEnd, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Preview" TextAlignment="Center" FontSize="16" FontWeight="Medium"/>
                <TextBlock Text="{Binding NightShiftStartPreview, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" FontSize="17" Margin="5" Grid.Row="2"/>
                <TextBlock Text="To" TextAlignment="Center" FontSize="16" Margin="8" Grid.Row="3"/>
                <TextBlock Text="{Binding NightShiftEndPreview, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" FontSize="17" Margin="5" Grid.Row="4"/>
            </StackPanel>
            
            <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 0 0 10">
                <Button Grid.Column="1"  Width="130" Style="{StaticResource BlackButton_patched}" Content="Update" Command="{Binding UpdateCommand}"/>
                <Button Grid.Column="1"  Width="130" Style="{StaticResource WhiteButton_patched}" Content="Cancel" Margin="10 0" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
