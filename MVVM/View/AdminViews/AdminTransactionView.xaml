<UserControl x:Class="ISCALE.MVVM.View.AdminViews.AdminTransactionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ISCALE.MVVM.View.AdminViews" xmlns:adminvms="clr-namespace:ISCALE.MVVM.ViewModel.AdminVMS" d:DataContext="{d:DesignInstance Type=adminvms:AdminTransactionVM}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <!-- Grid Layout-->
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <!-- Form Layout-->
        <Grid Background="White" Margin="10 10 10 5">
            <StackPanel Margin="10" Orientation="Vertical">
                <TextBlock Text="Find Transaction" FontWeight="SemiBold" FontSize="20" Margin="0 0 0 2"/>
                <!-- First Row-->
                <Grid Margin="0 0 0 5">
                    <!--First Row Layout-->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <!-- First Row Content-->
                    <StackPanel Orientation="Vertical" Margin="0 0 5 0">
                        <Grid Margin="0 0 0 5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Weigher" VerticalAlignment="Center"/>
                            <CheckBox IsEnabled="{Binding IsWeigherCheckEnabled}" VerticalContentAlignment="Center"  IsChecked="{Binding IsWeigherSpecific}" Grid.Column="1" HorizontalAlignment="Right">Specific</CheckBox>
                        </Grid>
                        <TextBox Text="{Binding Weigher, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Vertical" Grid.Column="1" Margin="5 0 5 0">
                        <TextBlock Text="Start Date" Margin="0 0 0 5"/>
                        <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}"  Style="{StaticResource D2_patched}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Vertical" Margin="5 0 0 0">
                        <TextBlock Text="End Date" Margin="0 0 0 5"/>
                        <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" Style="{StaticResource D2_patched}"/>
                    </StackPanel>
                </Grid>
                <!-- Second Row-->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="5 5 0 0 ">
                    <Button Width="131.5" Content="Search" Style="{StaticResource BlackButton_patched}" Margin="0 0 5 0" Command="{Binding SearchCommand}"/>
                    <Button Width="131.5" Grid.Column="1" Content="Clear" Style="{StaticResource WhiteButton_patched}" Margin="5 0 0 0" Command="{Binding ClearCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <!-- Table Content-->
        <Grid Grid.Row="1" Background="White" Margin="10 5 10 10">
            <!--Table Layout-->
            <Grid.RowDefinitions >
                <RowDefinition Height="auto"/>
                <RowDefinition/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Margin="10" Text="Transactions" FontWeight="SemiBold" FontSize="18"/>
                <CheckBox IsChecked="{Binding IsSelectedAll}" VerticalContentAlignment="Center" Content="Select All" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 10 0"/>
            <DataGrid Margin="10 0 10 10" Grid.Row="1" 
            ItemsSource="{Binding Transactions}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date Created" Binding="{Binding DateCreatedString, UpdateSourceTrigger=PropertyChanged}" Width=".45*"/>
                    <DataGridTextColumn Header="Transaction ID" Binding="{Binding TransactionId, UpdateSourceTrigger=PropertyChanged}" Width=".3*"/>
                    <DataGridTextColumn Header="Item Code #" Binding="{Binding Item.Code, UpdateSourceTrigger=PropertyChanged}" Width=".3*"/>
                    <DataGridTextColumn Header="Display Name" Binding="{Binding Item.Description, UpdateSourceTrigger=PropertyChanged}" Width=".3*"/>
                    <DataGridTextColumn Header="Section" Binding="{Binding Section, UpdateSourceTrigger=PropertyChanged}" Width=".22*"/>
                    <DataGridTextColumn Header="Supervisor" Binding="{Binding Supervisor.Username, UpdateSourceTrigger=PropertyChanged}" Width=".3*"/>
                    <DataGridTextColumn Header="Weigher" Binding="{Binding Weigher, UpdateSourceTrigger=PropertyChanged}" Width=".3*"/>
                    <DataGridTemplateColumn Header="View" Width=".3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Preview" Style="{StaticResource BlackButton_patched}" Command="{Binding DataContext.ViewCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" CommandParameter="{Binding}"  />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Select" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Margin="5" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Button Command="{Binding ExportReportCommand}" Content="Export Report" Grid.Row="2" Width="130" Style="{StaticResource BlackButton_patched}" Margin="0 0 10 10" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
