<UserControl x:Class="ISCALE.MVVM.View.ControlViews.ControlWindowHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ISCALE.MVVM.View.ControlViews"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Orientation="Horizontal" Margin="1 1 0 0" VerticalAlignment="Center">
            <Image Source="/Images/Default/app_logo.png" Height="18"/>
            <TextBlock x:Name="TB_VERSION" Foreground="{StaticResource BlackBrush}" FontFamily="{StaticResource Medium}" VerticalAlignment="Center" FontSize="14"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button
                HorizontalAlignment="Right" Margin="5" Height="23" Width="23"
                VerticalAlignment="Top" FontSize="20"
                Background="White"
                BorderThickness="0"
                x:Name="BTN_MINIMIZE"
                Click="BTN_MINIMIZE_Click">
                <Image Source="/Images/Icons/min.png"/>
            </Button>

            <Button
                HorizontalAlignment="Right" Margin="5" Height="23" Width="23"
                VerticalAlignment="Top" FontSize="16" FontWeight="Medium"
                BorderThickness="0"
                Background="White"
                x:Name="BTN_RESIZE"
                Click="BTN_RESIZE_Click">
                <Image Source="/Images/Icons/max.png"/>
            </Button>
            <Button
                HorizontalAlignment="Right" Margin="5" Height="23" Width="23"
                VerticalAlignment="Top" FontSize="15"
                BorderThickness="0"
                Background="White"
                x:Name="BTN_CLOSE"
                Click="BTN_CLOSE_Click">
                <Image Source="/Images/Icons/close.png"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
