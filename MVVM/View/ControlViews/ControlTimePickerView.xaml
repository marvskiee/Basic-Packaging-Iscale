<UserControl x:Class="ISCALE.MVVM.View.ControlViews.ControlTimePickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ISCALE.MVVM.View.ControlViews"
             mc:Ignorable="d" 
             x:Name="root"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <ComboBox
            Background="#F4F5F7"
            Style="{StaticResource ComboBoxStyle1}" HorizontalContentAlignment="Center" x:Name="CBX_HOURS" ItemsSource="{Binding SelectedTime.HoursCollection, ElementName=root}" SelectedItem="{Binding SelectedTime.Hour, ElementName=root,Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding StringFormat='{}{0:D2}'}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text=":" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="19"/>
        <ComboBox 
            Background="#F4F5F7"
            Style="{StaticResource ComboBoxStyle1}" Grid.Column="2" x:Name="CBX_MINUTES" ItemsSource="{Binding SelectedTime.MinutesCollection, ElementName=root}" SelectedItem="{Binding SelectedTime.Minute, ElementName=root, Mode=TwoWay}" HorizontalContentAlignment="Center">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding StringFormat='{}{0:D2}'}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </Grid>
</UserControl>
