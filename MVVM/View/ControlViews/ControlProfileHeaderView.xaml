<UserControl x:Class="ISCALE.MVVM.View.ControlViews.ControlProfileHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ISCALE.MVVM.View.ControlViews"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Avatar -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="{Binding Avatar}" RenderOptions.BitmapScalingMode="HighQuality" Height="30" Margin="10 10 10 10"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentUser.Username}"  TextAlignment="Left" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CurrentUser.Role}" TextAlignment="Left" FontFamily="{StaticResource Medium}" Foreground="{StaticResource BlackBrush}" FontSize="14" />
            </StackPanel>
        </Grid>

        <!-- Buttons -->
        <Grid Grid.Column="1" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Button Visibility="{Binding SettingVisibility}" Width="40" Margin="0 0 10 0" Style="{StaticResource BlackButton_patched}"  Command="{Binding SettingCommand}">
                <Image Source="/Images/Icons/cog.png" Height="25" Width="25"/>
            </Button>
            <Button Grid.Column="1" Margin="0 0 10 0" Width="130" Style="{StaticResource WhiteButton_patched}" Content="Logout" Command="{Binding LogoutCommand}"/>
        </Grid>
    </Grid>
</UserControl>
