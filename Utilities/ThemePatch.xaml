<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- TextBlock -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="15"></Setter>
    </Style>
    
    <!-- Password and TextBox -->
    <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
        <Setter Property="FontSize" Value="15"></Setter>
        <Setter Property="Height" Value="40"></Setter>
        <Setter Value="#F4F5F7" Property="Background"></Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontSize" Value="15"></Setter>
        <Setter Property="Height" Value="40"></Setter>
        <Setter Value="#F4F5F7" Property="Background"></Setter>
    </Style>

    <!-- DateTime -->
    <Style x:Key="D2_patched" TargetType="DatePicker" BasedOn="{StaticResource D2}">
        <Setter Property="FontSize" Value="15"></Setter>
        <Setter Property="MinHeight" Value="40"></Setter>
        <Setter Value="#F4F5F7" Property="Background"></Setter>
    </Style>
    
    <!-- Datagrid -->
    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid} }">
        <Setter Property="FontSize" Value="15"></Setter>
    </Style>

    <!-- Button -->
    <Style x:Key="BlackButton_patched" TargetType="Button" BasedOn="{StaticResource BlackButton}">
        <Setter Property="Height" Value="40"></Setter>
    </Style>
    <Style x:Key="WhiteButton_patched" TargetType="Button" BasedOn="{StaticResource WhiteButton}">
        <Setter Property="Height" Value="40"></Setter>
    </Style>
    <Style x:Key="RedButton_patched" TargetType="Button" BasedOn="{StaticResource RedButton}">
        <Setter Property="Height" Value="40"></Setter>
    </Style>
    
    <!-- Alert -->
    <Style x:Key="NormalAlert_patched" TargetType="TextBlock" BasedOn="{StaticResource NormalAlert}">
        <Setter Property="FontSize" Value="15"></Setter>
    </Style>
    <Style x:Key="SuccessAlert_patched" TargetType="TextBlock" BasedOn="{StaticResource SuccessAlert}">
        <Setter Property="FontSize" Value="15"></Setter>
    </Style>
    <Style x:Key="ErrorAlert_patched" TargetType="TextBlock" BasedOn="{StaticResource ErrorAlert}">
        <Setter Property="FontSize" Value="15"></Setter>
    </Style>
</ResourceDictionary>