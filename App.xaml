<Application x:Class="ISCALE.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ISCALE"
             xmlns:local1="clr-namespace:Formatter.Converter;assembly=Formatter"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Theme;component/Theme/Generic.xaml"/>
                <ResourceDictionary Source="Templates/AdminTemplates.xaml"/>
                <ResourceDictionary Source="/Utilities/ThemePatch.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <sys:Double x:Key="ComboBoxHeight">40</sys:Double>
            <local1:CurrencyViewConverter x:Key="MoneyFormatter"/>
            <local1:WeightViewConverter x:Key="KiloFormatter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
